# Only source and public documentation belong in a repository.
/*
!/.gitignore
!/.github/
!/backend/
!/frontend/
!/deploy/
!/tests/
!/README.md
!/DELIVERY.md
!/SECURITY.md
!/requirements.txt
!/run.sh

# Runtime state and credentials must never be committed, even inside source folders.
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.env
**/.env.*
**/data/
**/backups/
**/incoming/
**/publish/
**/tmp/
**/*.db
**/*.db-*
**/*.sqlite*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.crt
**/*.crl
**/*.log
**/*password*.txt
**/*.tar.gz
**/*.zip
